// Cloudflare Workers static-assets deployment (no Worker script: the site is fully static).
//   pnpm run deploy            # build + wrangler deploy
//   pnpm run cf:preview        # build + serve dist/ through the Workers runtime locally
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chonk-golf",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Routing is hash-based (#/s/<id>), so only "/" is ever requested; unknown paths get index.html anyway.
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Custom domain once the zone is on Cloudflare:
  // "routes": [{ "pattern": "chonk.golf", "custom_domain": true }]
}
