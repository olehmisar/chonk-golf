index 262abe690..1ed4ba0f2 100644
--- a/barretenberg/cpp/src/barretenberg/polynomials/fold_stride2.hpp
+++ b/barretenberg/cpp/src/barretenberg/polynomials/fold_stride2.hpp
@@ -9,6 +9,7 @@
 #include <array>
 #include <cstddef>
 #include <cstdint>
+#include <utility>
 
 namespace bb {
 
@@ -115,4 +116,39 @@ void fold_stride2(
     fold_scalar(k, end);
