+/**
+ * @brief Gate tiles stored in fixed-size chunks.
+ * @details Appending allocates a new chunk when the last one is full and never relocates existing tiles, unlike a
+ * std::vector whose regrowth copies every tile built so far. Tile `t` lives at slot `t % TILES_PER_CHUNK` of chunk
+ * `t / TILES_PER_CHUNK`. Tiles are value-initialized when appended.
+ */
+template <typename Tile> class TileStore {
+  public:
+    static constexpr size_t CHUNK_SHIFT = 5;
+    static constexpr size_t TILES_PER_CHUNK = size_t{ 1 } << CHUNK_SHIFT;
+    static constexpr size_t CHUNK_MASK = TILES_PER_CHUNK - 1;
+
+    TileStore() = default;
+    TileStore(const TileStore& other) { append_copies_of(other); }
+    TileStore& operator=(const TileStore& other)
+    {
+        if (this != &other) {
+            clear();
+            append_copies_of(other);
+        }
+        return *this;
+    }
+    TileStore(TileStore&& other) noexcept
+        : chunks_(std::move(other.chunks_))
+        , size_(std::exchange(other.size_, 0))
+    {}
+    TileStore& operator=(TileStore&& other) noexcept
+    {
+        if (this != &other) {
+            clear();
+            chunks_ = std::move(other.chunks_);
+            size_ = std::exchange(other.size_, 0);
+        }
+        return *this;
+    }
+    ~TileStore() { clear(); }
+
+    Tile& operator[](size_t t) { return chunks_[t >> CHUNK_SHIFT].get()[t & CHUNK_MASK]; }
+    const Tile& operator[](size_t t) const { return chunks_[t >> CHUNK_SHIFT].get()[t & CHUNK_MASK]; }
+
+    size_t size() const { return size_; }
+
+    Tile& emplace_back()
+    {
+        if (size_ == chunks_.size() * TILES_PER_CHUNK) {
+            chunks_.emplace_back(allocate_chunk());
+        }
+        Tile* tile = new (&(*this)[size_]) Tile{};
+        ++size_;
+        return *tile;
+    }
+
+    void reserve(size_t num_tiles) { chunks_.reserve((num_tiles + TILES_PER_CHUNK - 1) >> CHUNK_SHIFT); }
+
+    /**
+     * @brief Destroy all tiles and release all chunks.
+     */
+    void clear()
+    {
+        for (size_t t = 0; t < size_; ++t) {
+            (*this)[t].~Tile();
+        }
+        size_ = 0;
+        chunks_.clear();
+    }
+
+    void shrink_to_fit() { chunks_.shrink_to_fit(); }
+
+    bool operator==(const TileStore& other) const
+    {
+        if (size_ != other.size_) {
+            return false;
+        }
+        for (size_t t = 0; t < size_; ++t) {
+            if (!((*this)[t] == other[t])) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+  private:
+    struct ChunkDeleter {
+        void operator()(Tile* chunk) const { ::operator delete(chunk, std::align_val_t{ alignof(Tile) }); }
+    };
+    using Chunk = std::unique_ptr<Tile, ChunkDeleter>;
+
+    static Chunk allocate_chunk()
+    {
+        return Chunk(
+            static_cast<Tile*>(::operator new(sizeof(Tile) * TILES_PER_CHUNK, std::align_val_t{ alignof(Tile) })));
+    }
+
+    void append_copies_of(const TileStore& other)
+    {
+        reserve(other.size_);
+        for (size_t t = 0; t < other.size_; ++t) {
+            emplace_back() = other[t];
+        }
+    }
+
+    std::vector<Chunk> chunks_;
+    size_t size_ = 0;
+};
+
 /**
