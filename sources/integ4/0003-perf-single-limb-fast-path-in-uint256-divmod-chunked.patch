From 8ca78ec35c9192bf040128aa137f05ebf5deb274 Mon Sep 17 00:00:00 2001
From: opt <a@b>
Date: Sun, 11 Oct 2026 00:19:18 +0000
Subject: [PATCH 03/43] perf: single-limb fast path in uint256 divmod; chunked
 keccak normalize_sparse

---
 .../numeric/uint256/uint256_impl.hpp          | 47 +++++++++++++++++--
 .../stdlib/hash/keccak/keccak.hpp             | 33 +++++++++----
 2 files changed, 67 insertions(+), 13 deletions(-)

diff --git a/barretenberg/cpp/src/barretenberg/numeric/uint256/uint256_impl.hpp b/barretenberg/cpp/src/barretenberg/numeric/uint256/uint256_impl.hpp
index 6e0cecd..18d7567 100644
--- a/barretenberg/cpp/src/barretenberg/numeric/uint256/uint256_impl.hpp
+++ b/barretenberg/cpp/src/barretenberg/numeric/uint256/uint256_impl.hpp
@@ -149,6 +149,11 @@ constexpr std::pair<uint256_t, uint256_t> uint256_t::divmod(const uint256_t& b)
     if (b > *this) {
         return { 0, *this };
     }
+    // Single-limb divisor: limb-wise long division is far cheaper than the bitwise shift-subtract loop below.
+    if ((b.data[1] | b.data[2] | b.data[3]) == 0) {
+        const auto [q, r] = divmod(b.data[0]);
+        return { q, uint256_t(r) };
+    }
 
     uint256_t quotient = 0;
     uint256_t remainder = *this;
@@ -212,9 +217,45 @@ constexpr std::pair<uint256_t, uint64_t> uint256_t::divmod(uint64_t b) const
     }
     return { quotient, remainder };
 #else
-    // Fallback to the general divmod since wasm doesn't have native support for 128-bit instructions.
-    auto [q, r] = divmod(uint256_t(b));
-    return { q, static_cast<uint64_t>(r.data[0]) };
+    if (b <= 0xffffffffULL) {
+        // Schoolbook long division in base 2^32: each step divides a 64-bit intermediate (remainder << 32 | half-limb)
+        // by b, which only needs native 64-bit arithmetic.
+        uint256_t quotient;
+        uint64_t remainder = 0;
+        for (int i = 3; i >= 0; --i) {
+            const uint64_t hi = (remainder << 32) | (data[i] >> 32);
+            const uint64_t q_hi = hi / b;
+            remainder = hi % b;
+            const uint64_t lo = (remainder << 32) | (data[i] & 0xffffffffULL);
+            const uint64_t q_lo = lo / b;
+            remainder = lo % b;
+            quotient.data[i] = (q_hi << 32) | q_lo;
+        }
+        return { quotient, remainder };
+    }
+    // Fallback to the bitwise division since wasm doesn't have native support for 128-bit instructions.
+    uint256_t quotient = 0;
+    uint256_t remainder = *this;
+    const uint256_t divisor_256(b);
+    if (divisor_256 > remainder) {
+        return { 0, data[0] };
+    }
+    uint64_t bit_difference = get_msb() - divisor_256.get_msb();
+    uint256_t divisor = divisor_256 << bit_difference;
+    uint256_t accumulator = uint256_t(1) << bit_difference;
+    if (divisor > remainder) {
+        divisor >>= 1;
+        accumulator >>= 1;
+    }
+    while (remainder >= divisor_256) {
+        if (remainder >= divisor) {
+            remainder -= divisor;
+            quotient |= accumulator;
+        }
+        divisor >>= 1;
+        accumulator >>= 1;
+    }
+    return { quotient, static_cast<uint64_t>(remainder.data[0]) };
 #endif
 }
 
diff --git a/barretenberg/cpp/src/barretenberg/stdlib/hash/keccak/keccak.hpp b/barretenberg/cpp/src/barretenberg/stdlib/hash/keccak/keccak.hpp
index 7e532f4..2649eeb 100644
--- a/barretenberg/cpp/src/barretenberg/stdlib/hash/keccak/keccak.hpp
+++ b/barretenberg/cpp/src/barretenberg/stdlib/hash/keccak/keccak.hpp
@@ -5,6 +5,7 @@
 // =====================
 
 #pragma once
+#include "barretenberg/numeric/bitop/pow.hpp"
 #include "barretenberg/stdlib/primitives/byte_array/byte_array.hpp"
 #include <array>
 
@@ -92,19 +93,31 @@ template <typename Builder> class keccak {
      */
     static constexpr uint256_t normalize_sparse(uint256_t input)
     {
-        std::array<uint64_t, 64> out_bits;
-        size_t count = 0;
+        // Peel off the base-11 digits in chunks of NORMALIZE_CHUNK_DIGITS so that only one wide division is needed
+        // per chunk and the per-digit work is native 64-bit arithmetic. The chunk base fits in a single limb (and in
+        // 32 bits on wasm, where only 64-bit native division is available).
+#if defined(__wasm__)
+        constexpr size_t NORMALIZE_CHUNK_DIGITS = 9;
+#else
+        constexpr size_t NORMALIZE_CHUNK_DIGITS = 18;
+#endif
+        constexpr uint64_t chunk_base = numeric::pow64(11, NORMALIZE_CHUNK_DIGITS);
+        uint256_t out = 0;
+        uint256_t chunk_place = 1;
         while (input > 0) {
-            const auto [quotient, slice] = input.divmod(BASE);
-            uint64_t bit = static_cast<uint64_t>(slice) & 1;
-            out_bits[count++] = bit;
+            const auto [quotient, chunk] = input.divmod(chunk_base);
+            uint64_t remaining = chunk;
+            uint64_t normalized_chunk = 0;
+            uint64_t digit_place = 1;
+            for (size_t i = 0; i < NORMALIZE_CHUNK_DIGITS && remaining > 0; ++i) {
+                normalized_chunk += ((remaining % 11) & 1) * digit_place;
+                remaining /= 11;
+                digit_place *= 11;
+            }
+            out += chunk_place * uint256_t(normalized_chunk);
+            chunk_place *= uint256_t(chunk_base);
             input = quotient;
         }
-        uint256_t out;
-        for (size_t i = 0; i < count; ++i) {
-            out *= BASE;
-            out += out_bits[count - 1 - i];
-        }
         return out;
     }
 
-- 
