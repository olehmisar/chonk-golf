From 30e9f437a74b397d9246996397971a99768996bc Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 11 Oct 2026 02:46:52 +0000
Subject: [PATCH 3/5] perf(polynomials): skip zero source entries in
 add_scaled_batch

Selector and sparse witness columns are ~35% zeros in the Hypernova batch_polynomials inputs;
c * 0 adds nothing to the destination.
---
 .../cpp/src/barretenberg/polynomials/polynomial.cpp         | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/barretenberg/cpp/src/barretenberg/polynomials/polynomial.cpp b/barretenberg/cpp/src/barretenberg/polynomials/polynomial.cpp
index 390fd28..efed415 100644
--- a/barretenberg/cpp/src/barretenberg/polynomials/polynomial.cpp
+++ b/barretenberg/cpp/src/barretenberg/polynomials/polynomial.cpp
@@ -279,8 +279,12 @@ void add_scaled_batch(Polynomial<Fr>& dst,
             const size_t idx_start = std::max(chunk_start, src_start);
             const size_t idx_end = std::min(chunk_end + 1, src_end);
 
+            // Zero source entries (common in selector and sparse witness columns) contribute nothing and are skipped
             for (size_t i = idx_start; i < idx_end; ++i) {
-                dst.at(i) += c * src[i];
+                const Fr& value = src[i];
+                if (!value.is_zero()) {
+                    dst.at(i) += c * value;
+                }
             }
         }
     });
-- 
