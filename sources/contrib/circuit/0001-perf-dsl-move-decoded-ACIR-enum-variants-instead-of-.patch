From 8c2355736515162072379614ba58041af64b8682 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 11 Oct 2026 01:42:00 +0000
Subject: [PATCH 1/5] perf(dsl): move decoded ACIR enum variants instead of
 copying; string_view field names

The generated serde decoders built each enum variant in a local and copy-assigned it into the
std::variant (deep-copying every Expression / vector of coefficients), and passed field-name
literals as std::string const&, allocating a temporary per field for names over 15 chars
(e.g. linear_combinations on every Expression). Variants are now moved in and field names are
std::string_view. The same edit should be made in the noir cpp_codegen generator.
---
 .../dsl/acir_format/serde/acir.hpp            | 413 +++++++++---------
 .../dsl/acir_format/serde/serde.hpp           |   1 +
 .../dsl/acir_format/serde/witness_stack.hpp   |  13 +-
 3 files changed, 215 insertions(+), 212 deletions(-)

diff --git a/barretenberg/cpp/src/barretenberg/dsl/acir_format/serde/acir.hpp b/barretenberg/cpp/src/barretenberg/dsl/acir_format/serde/acir.hpp
index 68bf0db..4df9b60 100644
--- a/barretenberg/cpp/src/barretenberg/dsl/acir_format/serde/acir.hpp
+++ b/barretenberg/cpp/src/barretenberg/dsl/acir_format/serde/acir.hpp
@@ -56,22 +56,23 @@ struct Helpers {
     template <typename T>
     static void conv_fld_from_array(msgpack::object_array const& array,
                                     std::string const& struct_name,
-                                    std::string const& field_name,
+                                    std::string_view field_name,
                                     T& field,
                                     uint32_t index)
     {
         if (index >= array.size) {
-            throw_or_abort("index out of bounds: " + struct_name + "::" + field_name + " at " + std::to_string(index));
+            throw_or_abort("index out of bounds: " + struct_name + "::" + std::string(field_name) + " at " +
+                           std::to_string(index));
         }
         auto element = array.ptr[index];
         if (element.type == msgpack::type::NIL) {
-            throw_or_abort("nil value for required field: " + struct_name + "::" + field_name);
+            throw_or_abort("nil value for required field: " + struct_name + "::" + std::string(field_name));
         }
         try {
             element.convert(field);
         } catch (const msgpack::type_error&) {
             std::cerr << element << std::endl;
-            throw_or_abort("error converting into field " + struct_name + "::" + field_name);
+            throw_or_abort("error converting into field " + struct_name + "::" + std::string(field_name));
         }
     }
 
