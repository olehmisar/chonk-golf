         {
-            BB_BENCH_NAME("joint_sumcheck/hiding_kernel");
-            {
-                BB_BENCH_NAME("joint_sumcheck/hiding_kernel/partially_evaluate");
-                MegaZKSumcheck::partially_evaluate(mega_zk_polys, mega_zk_partial, u);
-            }
-        }
-        {
