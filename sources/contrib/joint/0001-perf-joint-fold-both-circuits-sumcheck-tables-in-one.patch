                                                          std::shared_ptr<MegaZKVK> mega_zk_vk,
                                                          std::shared_ptr<Transcript> transcript)
@@ -201,18 +261,8 @@ void BatchedHonkTranslatorProver::execute_joint_sumcheck_rounds()
     {
