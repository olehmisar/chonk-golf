From 59af80bed71b5e7ff3c337fab51406c78085bdd6 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 11 Oct 2026 03:00:57 +0000
Subject: [PATCH 3/4] perf(msm): pad IFMA drain queue rows by one cache line

The queue's limb rows were exactly 2 KiB apart, so the 26 rows a lane group touches mapped
to two L1 sets. A 64-byte pad per row spreads them out. No arithmetic change.
---
 .../batch_affine_ifma.hpp                     | 22 ++++++++++---------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/barretenberg/cpp/src/barretenberg/ecc/scalar_multiplication/batch_affine_ifma.hpp b/barretenberg/cpp/src/barretenberg/ecc/scalar_multiplication/batch_affine_ifma.hpp
index 37ed627..fd6892a 100644
--- a/barretenberg/cpp/src/barretenberg/ecc/scalar_multiplication/batch_affine_ifma.hpp
+++ b/barretenberg/cpp/src/barretenberg/ecc/scalar_multiplication/batch_affine_ifma.hpp
@@ -267,12 +267,14 @@ BB_IFMA_INLINE void store52(const V5& v, uint64_t* base, size_t stride)
  */
 template <size_t CAP> struct DrainBuffer {
     static_assert(CAP % 8 == 0);
-    alignas(64) uint64_t lx[4][CAP];
-    alignas(64) uint64_t ly[4][CAP];
-    alignas(64) uint64_t rx[4][CAP];
-    alignas(64) uint64_t ry[4][CAP];
-    alignas(64) uint64_t dx[5][CAP];
-    alignas(64) uint64_t pre[5][CAP];
+    // Row stride: one cache line past CAP, so the limbs of one lane group do not all map to the same cache set.
+    static constexpr size_t STRIDE = CAP + 8;
+    alignas(64) uint64_t lx[4][STRIDE];
+    alignas(64) uint64_t ly[4][STRIDE];
+    alignas(64) uint64_t rx[4][STRIDE];
+    alignas(64) uint64_t ry[4][STRIDE];
+    alignas(64) uint64_t dx[5][STRIDE];
+    alignas(64) uint64_t pre[5][STRIDE];
     uint32_t pair_dest[CAP];
 
     template <typename BaseField>
@@ -331,8 +333,8 @@ BB_IFMA_TARGET void drain_vector(DrainBuffer<CAP>& buf, size_t n, Sink&& sink)
         const V5 x1 = load64(&buf.lx[0][k], &buf.lx[1][k], &buf.lx[2][k], &buf.lx[3][k]);
         const V5 x2 = load64(&buf.rx[0][k], &buf.rx[1][k], &buf.rx[2][k], &buf.rx[3][k]);
         const V5 dx = sub_plus(x2, x1, C::P2);
-        store52(dx, &buf.dx[0][k], CAP);
-        store52(acc, &buf.pre[0][k], CAP);
+        store52(dx, &buf.dx[0][k], DrainBuffer<CAP>::STRIDE);
+        store52(acc, &buf.pre[0][k], DrainBuffer<CAP>::STRIDE);
         acc = mont_mul<Params>(acc, dx);
     }
 
@@ -367,8 +369,8 @@ BB_IFMA_TARGET void drain_vector(DrainBuffer<CAP>& buf, size_t n, Sink&& sink)
     alignas(64) uint64_t oy[4][8];
     for (size_t k = padded; k != 0;) {
         k -= 8;
-        const V5 inv_dx = mont_mul<Params>(acc, load52(&buf.pre[0][k], CAP));
-        acc = mont_mul<Params>(acc, load52(&buf.dx[0][k], CAP));
+        const V5 inv_dx = mont_mul<Params>(acc, load52(&buf.pre[0][k], DrainBuffer<CAP>::STRIDE));
+        acc = mont_mul<Params>(acc, load52(&buf.dx[0][k], DrainBuffer<CAP>::STRIDE));
         const V5 x1 = load64(&buf.lx[0][k], &buf.lx[1][k], &buf.lx[2][k], &buf.lx[3][k]);
         const V5 y1 = load64(&buf.ly[0][k], &buf.ly[1][k], &buf.ly[2][k], &buf.ly[3][k]);
         const V5 x2 = load64(&buf.rx[0][k], &buf.rx[1][k], &buf.rx[2][k], &buf.rx[3][k]);
