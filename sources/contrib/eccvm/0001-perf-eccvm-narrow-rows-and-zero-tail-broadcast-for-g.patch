+/**
+ * @brief The narrow row getters used by the grand product and log-derivative inverse computations read every column
+ * their relations use: on every row they produce the same relation values as the full get_row, and every row at or
+ * beyond the reported zero-row start produces the values of that start row.
+ */
+TEST_F(ECCVMTests, NarrowRowGettersMatchFullRow)
+{
+    using SetRelation = std::tuple_element_t<0, ECCVMFlavor::GrandProductRelations>;
+    using LookupRelation = ECCVMFlavor::LookupRelation;
+    using SetAccumulator = std::tuple_element_t<0, typename SetRelation::SumcheckArrayOfValuesOverSubrelations>;
+    using LookupAccumulator = typename LookupRelation::ValueAccumulator0;
+
+    ECCVMCircuitBuilder builder = generate_circuit(&engine);
+    ECCVMFlavor::ProverPolynomials polynomials(builder);
+    const auto params = RelationParameters<FF>::get_random();
+    const size_t num_rows = polynomials.get_polynomial_size();
+
+    const auto set_values = [&](const auto& row) {
+        return std::array<FF, 2>{ SetRelation::template compute_grand_product_numerator<SetAccumulator>(row, params),
+                                  SetRelation::template compute_grand_product_denominator<SetAccumulator>(row,
+                                                                                                          params) };
+    };
+    const auto lookup_values = [&](const auto& row) {
+        std::array<FF, LookupRelation::NUM_LOOKUP_TERMS + LookupRelation::NUM_TABLE_TERMS + 1> values;
+        values[0] = FF(static_cast<uint64_t>(LookupRelation::operation_exists_at_row(row)));
+        bb::constexpr_for<0, LookupRelation::NUM_LOOKUP_TERMS, 1>([&]<size_t i>() {
+            values[1 + i] = LookupRelation::template compute_lookup_term<LookupAccumulator, i>(row, params);
+        });
+        bb::constexpr_for<0, LookupRelation::NUM_TABLE_TERMS, 1>([&]<size_t i>() {
+            values[1 + LookupRelation::NUM_LOOKUP_TERMS + i] =
+                LookupRelation::template compute_table_term<LookupAccumulator, i>(row, params);
+        });
+        return values;
+    };
+
+    const size_t grand_product_zero_row_start = polynomials.get_grand_product_zero_row_start();
+    const size_t lookup_zero_row_start = polynomials.get_logderivative_inverse_zero_row_start();
+    EXPECT_LT(grand_product_zero_row_start, num_rows);
+    EXPECT_LT(lookup_zero_row_start, num_rows);
+    const auto grand_product_zero_row_values =
+        set_values(polynomials.get_row_for_grand_product(grand_product_zero_row_start));
+    const auto lookup_zero_row_values =
+        lookup_values(polynomials.get_row_for_logderivative_inverse(lookup_zero_row_start));
+    EXPECT_EQ(lookup_zero_row_values[0], FF(0));
+
+    for (size_t row_idx = 0; row_idx < num_rows; ++row_idx) {
+        const auto full_row = polynomials.get_row(row_idx);
+        const auto full_set_values = set_values(full_row);
+        const auto full_lookup_values = lookup_values(full_row);
+        ASSERT_EQ(full_set_values, set_values(polynomials.get_row_for_grand_product(row_idx))) << "row " << row_idx;
+        ASSERT_EQ(full_lookup_values, lookup_values(polynomials.get_row_for_logderivative_inverse(row_idx)))
+            << "row " << row_idx;
+        if (row_idx >= grand_product_zero_row_start) {
+            ASSERT_EQ(full_set_values, grand_product_zero_row_values) << "row " << row_idx;
+        }
+        if (row_idx >= lookup_zero_row_start) {
+            ASSERT_EQ(full_lookup_values, lookup_zero_row_values) << "row " << row_idx;
+        }
+    }
+}
