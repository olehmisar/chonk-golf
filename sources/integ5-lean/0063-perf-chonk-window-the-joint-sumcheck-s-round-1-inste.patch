@@ -39,6 +39,21 @@ namespace bb {
  * @note `dst` must be writable over `[begin, end)`; reads of `src` at index `2k`/`2k+1` are answered by
  * `get`, so out-of-extent reads yield zero rather than UB.
  */
+/**
+ * @brief The fold of one source pair, `even + challenge * (odd - even)`, exactly as `fold_stride2` computes each
+ * output on its scalar path.
+ */
+template <typename Fr> Fr fold_stride2_pair(const Fr& even, const Fr& odd, const Fr& challenge)
+{
+    // Equal neighbours (constant selector runs, zero padding inside the active extent) fold to themselves, so skip
+    // the multiplication. Only bit-identical representations are short-cut.
+    if (even.data[0] == odd.data[0] && even.data[1] == odd.data[1] && even.data[2] == odd.data[2] &&
+        even.data[3] == odd.data[3]) {
+        return even;
+    }
+    return even + challenge * (odd - even);
+}
