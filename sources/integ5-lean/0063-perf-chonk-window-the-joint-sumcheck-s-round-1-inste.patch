+// Rows of the round-1 tables materialized at a time by the windowed round 1 (see execute_joint_sumcheck_rounds).
+constexpr size_t ROUND_ONE_WINDOW_SIZE = 8192;
+
+// Number of entries of a table after one partial evaluation: one per source pair, an odd tail folding against zero.
+inline size_t folded_size(const size_t size)
+{
+    return (size / 2) + (size % 2);
+}
+
+/**
+ * @brief Allocate `window` to hold rows `[begin, end)` of the table that partially evaluating `full` would produce.
+ * @details Entity k gets the overlap of `[begin, end)` with that table's extent `[0, folded_size(end_k))`, indexed by
+ * absolute row with the same virtual size, so every row outside the window reads as zero.
+ */
+template <typename FF, typename Window, typename Full>
+void allocate_round_one_window(Window& window, const Full& full, size_t begin, size_t end, size_t virtual_size)
+{
+    for (auto [window_poly, full_poly] : zip_view(window.get_all(), full.get_all())) {
+        const size_t folded_end = folded_size(full_poly.end_index());
+        const size_t window_begin = std::min(begin, folded_end);
+        const size_t window_end = std::min(end, folded_end);
+        window_poly =
+            Polynomial<FF>(window_end - window_begin, virtual_size, window_begin, Polynomial<FF>::DontZeroMemory::FLAG);
+    }
+}
+
+/**
+ * @brief Partially evaluate `full` at `first_challenge` and the result at `second_challenge` into `dest`, without
+ * materializing the intermediate table.
+ * @details Entity k of the intermediate table holds `folded_size(end_k)` entries; `dest` gets one entry per pair of
+ * them. Each entry is computed by `fold_stride2_pair` from the same operands as two successive `fold_stride2` passes
+ * would use (entries past an extent read as zero), so `dest` is bit-identical to the two-pass result.
+ */
+struct SizedJob {
+    size_t size;
+    std::function<void()> run;
+};
+
+template <typename FF, typename Dest, typename Full>
+void allocate_and_fold_twice(std::vector<SizedJob>& jobs,
+                             Dest& dest,
+                             const Full& full,
+                             size_t virtual_size,
+                             const FF& first_challenge,
+                             const FF& second_challenge)
+{
+    for (auto [dest_poly, full_poly] : zip_view(dest.get_all(), full.get_all())) {
+        const size_t once_size = folded_size(full_poly.end_index());
+        const size_t twice_size = folded_size(once_size);
+        dest_poly = Polynomial<FF>(twice_size, virtual_size, 0, Polynomial<FF>::DontZeroMemory::FLAG);
+        jobs.push_back(
+            { twice_size, [&dest_poly, &full_poly, once_size, twice_size, &first_challenge, &second_challenge]() {
+                 auto once = [&](size_t k) {
+                     return k < once_size ? fold_stride2_pair(full_poly[2 * k], full_poly[(2 * k) + 1], first_challenge)
+                                          : FF::zero();
+                 };
+                 // Outputs whose four source entries lie inside the stored extent read them directly; the others
+                 // (at most a few at either end) go through the virtual-zero-aware accessor.
+                 const size_t source_start = full_poly.start_index();
+                 const size_t source_end = full_poly.end_index();
+                 const size_t direct_begin = std::min(twice_size, (source_start + 3) / 4);
+                 const size_t direct_end = std::max(direct_begin, std::min(twice_size, source_end / 4));
+                 const FF* source = full_poly.data();
+                 FF* dest = dest_poly.data();
+                 for (size_t m = 0; m < direct_begin; ++m) {
+                     dest[m] = fold_stride2_pair(once(2 * m), once((2 * m) + 1), second_challenge);
+                 }
+                 for (size_t m = direct_begin; m < direct_end; ++m) {
+                     const FF* quad = source + ((4 * m) - source_start);
+                     dest[m] = fold_stride2_pair(fold_stride2_pair(quad[0], quad[1], first_challenge),
+                                                 fold_stride2_pair(quad[2], quad[3], first_challenge),
+                                                 second_challenge);
+                 }
+                 for (size_t m = direct_end; m < twice_size; ++m) {
+                     dest[m] = fold_stride2_pair(once(2 * m), once((2 * m) + 1), second_challenge);
+                 }
+             } });
+    }
+    if constexpr (requires {
+                      full.row_skip_active_prefix_end;
+                      dest.row_skip_active_prefix_end;
+                  }) {
+        dest.row_skip_active_prefix_end = folded_size(folded_size(full.row_skip_active_prefix_end));
+    }
+}
