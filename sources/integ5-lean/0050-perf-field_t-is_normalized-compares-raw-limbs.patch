From a3740dbd89babc97c1e92d67530cf515e3ff90eb Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 11 Oct 2026 03:08:57 +0000
Subject: [PATCH 50/65] perf(field_t): is_normalized compares raw limbs

bb::fr::operator== reduces both operands. is_normalized() (called by every normalize(), get_witness_index
consumer, ROM/RAM/databus access, ...) now checks the multiplicative constant against the two raw
representatives of 1 (ONE and ONE + p; elements are held in [0, 2p), the invariant operator== relies on)
and the additive constant with fr::is_zero(), which already checks 0 and p.
---
 .../stdlib/primitives/field/field.hpp            | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/barretenberg/cpp/src/barretenberg/stdlib/primitives/field/field.hpp b/barretenberg/cpp/src/barretenberg/stdlib/primitives/field/field.hpp
index 8d6326f..430aab9 100644
--- a/barretenberg/cpp/src/barretenberg/stdlib/primitives/field/field.hpp
+++ b/barretenberg/cpp/src/barretenberg/stdlib/primitives/field/field.hpp
@@ -54,6 +54,20 @@ template <typename Builder_> class field_t {
     static constexpr bb::fr ONE = bb::fr::one();
     static constexpr bb::fr NEG_ONE = bb::fr::neg_one();
 
+    /**
+     * @brief Whether x == 1, without the two reductions of bb::fr::operator==
+     * @details A field element is held in [0, 2p) (the invariant bb::fr::operator== relies on), so 1 has exactly the
+     * raw representatives ONE and ONE + p.
+     */
+    static bool is_one(const bb::fr& x)
+    {
+        static_assert(bb::fr::modulus.get_msb() < 255, "ONE + p must fit in 256 bits");
+        constexpr uint256_t one_raw(ONE.data[0], ONE.data[1], ONE.data[2], ONE.data[3]);
+        constexpr uint256_t one_plus_modulus_raw = one_raw + bb::fr::modulus;
+        const uint256_t x_raw(x.data[0], x.data[1], x.data[2], x.data[3]);
+        return (x_raw == one_raw) || (x_raw == one_plus_modulus_raw);
+    }
+
     // Friend declarations for classes that need direct witness_index access
     template <typename B> friend class bool_t;
     template <typename B, typename T> friend class bigfield;
@@ -460,7 +474,7 @@ template <typename Builder_> class field_t {
     bool is_constant() const { return witness_index == IS_CONSTANT; }
     bool is_normalized() const
     {
-        return (is_constant() || ((multiplicative_constant == ONE) && (additive_constant == bb::fr::zero())));
+        return (is_constant() || (is_one(multiplicative_constant) && additive_constant.is_zero()));
     };
     uint32_t set_public() const
     {
