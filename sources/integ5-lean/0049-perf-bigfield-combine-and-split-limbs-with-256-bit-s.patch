From 25cb2937ba0b7a7e92e50a37cdaf19f25ca61123 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 11 Oct 2026 02:56:29 +0000
Subject: [PATCH 49/65] perf(bigfield): combine and split limbs with 256-bit
 shifts

get_value() and get_maximum_value() (queried on every operation for reduction decisions) shifted uint512_t
values limb by limb, and create_from_u512_as_witness sliced the value with 512-bit shifts and masks.
combine_limbs / split_into_limbs compute the same integers with 256-bit shifts by compile-time amounts.
---
 .../stdlib/primitives/bigfield/bigfield.hpp   | 30 +++++++++++++++++++
 .../primitives/bigfield/bigfield_impl.hpp     | 24 ++++++---------
 2 files changed, 39 insertions(+), 15 deletions(-)

diff --git a/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield.hpp b/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield.hpp
index 8d7fa7a..26e3b07 100644
--- a/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield.hpp
+++ b/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield.hpp
@@ -854,6 +854,36 @@ template <typename Builder, typename T> class bigfield {
         return maximum_product;
     }
 
+    /**
+     * @brief Compute sum_i limbs[i] * 2^(i * NUM_LIMB_BITS) for limbs below 2^256
+     * @details Each shifted limb is assembled from two 256-bit shifts by compile-time amounts, which is cheaper than
+     * shifting 512-bit integers.
+     */
+    static uint512_t combine_limbs(const std::array<uint256_t, NUM_LIMBS>& limbs)
+    {
+        static_assert(NUM_LIMB_BITS * (NUM_LIMBS - 1) < 256);
+        uint512_t result(limbs[0]);
+        result += uint512_t(limbs[1] << NUM_LIMB_BITS, limbs[1] >> (256 - NUM_LIMB_BITS));
+        result += uint512_t(limbs[2] << (NUM_LIMB_BITS * 2), limbs[2] >> (256 - (NUM_LIMB_BITS * 2)));
+        result += uint512_t(limbs[3] << (NUM_LIMB_BITS * 3), limbs[3] >> (256 - (NUM_LIMB_BITS * 3)));
+        return result;
+    }
+
+    /**
+     * @brief Split the low NUM_LIMBS * NUM_LIMB_BITS bits of a value into NUM_LIMB_BITS-bit limbs
+     * @details Equivalent to value.slice(i * NUM_LIMB_BITS, (i + 1) * NUM_LIMB_BITS) for each limb, using 256-bit
+     * operations.
+     */
+    static std::array<uint256_t, NUM_LIMBS> split_into_limbs(const uint512_t& value)
+    {
+        static_assert(NUM_LIMB_BITS * (NUM_LIMBS - 1) < 256 && NUM_LIMB_BITS * NUM_LIMBS > 256);
+        constexpr uint256_t limb_mask = (uint256_t(1) << NUM_LIMB_BITS) - 1;
+        return { value.lo & limb_mask,
+                 (value.lo >> NUM_LIMB_BITS) & limb_mask,
+                 (value.lo >> (NUM_LIMB_BITS * 2)) & limb_mask,
+                 ((value.lo >> (NUM_LIMB_BITS * 3)) | (value.hi << (256 - (NUM_LIMB_BITS * 3)))) & limb_mask };
+    }
+
     /**
      * @brief Reduce a value modulo the target modulus, skipping the division when it is already reduced
      */
diff --git a/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield_impl.hpp b/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield_impl.hpp
index f1d1efd..9bb903e 100644
--- a/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield_impl.hpp
+++ b/barretenberg/cpp/src/barretenberg/stdlib/primitives/bigfield/bigfield_impl.hpp
@@ -145,11 +145,7 @@ bigfield<Builder, T> bigfield<Builder, T>::create_from_u512_as_witness(Builder*
 {
     BB_ASSERT((can_overflow == true && maximum_bitlength == 0) ||
               (can_overflow == false && (maximum_bitlength == 0 || maximum_bitlength > (3 * NUM_LIMB_BITS))));
-    std::array<uint256_t, NUM_LIMBS> limbs;
-    limbs[0] = value.slice(0, NUM_LIMB_BITS).lo;
-    limbs[1] = value.slice(NUM_LIMB_BITS, NUM_LIMB_BITS * 2).lo;
-    limbs[2] = value.slice(NUM_LIMB_BITS * 2, NUM_LIMB_BITS * 3).lo;
-    limbs[3] = value.slice(NUM_LIMB_BITS * 3, NUM_LIMB_BITS * 4).lo;
+    const std::array<uint256_t, NUM_LIMBS> limbs = split_into_limbs(value);
 
     field_t<Builder> limb_0(ctx);
     field_t<Builder> limb_1(ctx);
@@ -303,20 +299,18 @@ template <typename Builder, typename T> bigfield<Builder, T>& bigfield<Builder,
 
 template <typename Builder, typename T> uint512_t bigfield<Builder, T>::get_value() const
 {
-    uint512_t t0 = uint256_t(binary_basis_limbs[0].element.get_value());
-    uint512_t t1 = uint256_t(binary_basis_limbs[1].element.get_value());
-    uint512_t t2 = uint256_t(binary_basis_limbs[2].element.get_value());
-    uint512_t t3 = uint256_t(binary_basis_limbs[3].element.get_value());
-    return t0 + (t1 << (NUM_LIMB_BITS)) + (t2 << (2 * NUM_LIMB_BITS)) + (t3 << (3 * NUM_LIMB_BITS));
+    return combine_limbs({ uint256_t(binary_basis_limbs[0].element.get_value()),
+                           uint256_t(binary_basis_limbs[1].element.get_value()),
+                           uint256_t(binary_basis_limbs[2].element.get_value()),
+                           uint256_t(binary_basis_limbs[3].element.get_value()) });
 }
 
 template <typename Builder, typename T> uint512_t bigfield<Builder, T>::get_maximum_value() const
 {
-    uint512_t t0 = uint512_t(binary_basis_limbs[0].maximum_value);
-    uint512_t t1 = uint512_t(binary_basis_limbs[1].maximum_value) << NUM_LIMB_BITS;
-    uint512_t t2 = uint512_t(binary_basis_limbs[2].maximum_value) << (NUM_LIMB_BITS * 2);
-    uint512_t t3 = uint512_t(binary_basis_limbs[3].maximum_value) << (NUM_LIMB_BITS * 3);
-    return t0 + t1 + t2 + t3;
+    return combine_limbs({ binary_basis_limbs[0].maximum_value,
+                           binary_basis_limbs[1].maximum_value,
+                           binary_basis_limbs[2].maximum_value,
+                           binary_basis_limbs[3].maximum_value });
 }
 
 template <typename Builder, typename T>
