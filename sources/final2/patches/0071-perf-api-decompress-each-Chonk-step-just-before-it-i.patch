From fe8cc83a9b9e9fdabd06ff21e4bdd55bbcbd88a7 Mon Sep 17 00:00:00 2001
From: bench <bench@local>
Date: Sun, 11 Oct 2026 06:33:46 +0000
Subject: [PATCH 71/75] perf(api): decompress each Chonk step just before it is
 loaded

ChonkAPI::prove decompressed the bytecode and witness of every step up front, so the decompressed
programs of all steps not yet accumulated stayed resident through the accumulation of the earlier
ones. Keep the steps compressed and decompress each one right before ChonkLoad.
---
 barretenberg/cpp/src/barretenberg/api/api_chonk.cpp | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/barretenberg/cpp/src/barretenberg/api/api_chonk.cpp b/barretenberg/cpp/src/barretenberg/api/api_chonk.cpp
index dbfa69321..47c11dcd1 100644
--- a/barretenberg/cpp/src/barretenberg/api/api_chonk.cpp
+++ b/barretenberg/cpp/src/barretenberg/api/api_chonk.cpp
@@ -77,7 +77,9 @@ void ChonkAPI::prove(const Flags& flags,
     BB_BENCH_NAME("ChonkAPI::prove");
     bbapi::BBApiRequest request;
     request.vk_policy = bbapi::parse_vk_policy(flags.vk_policy);
-    std::vector<PrivateExecutionStepRaw> raw_steps = PrivateExecutionStepRaw::load_and_decompress(input_path);
+    // Steps stay compressed until their turn: only the step being accumulated holds its decompressed bytecode and
+    // witness.
+    std::vector<PrivateExecutionStepRaw> raw_steps = PrivateExecutionStepRaw::load(input_path);
 
     std::vector<CircuitKind> kinds;
     kinds.reserve(raw_steps.size());
@@ -88,6 +90,7 @@ void ChonkAPI::prove(const Flags& flags,
     info("Chonk: starting with ", raw_steps.size(), " circuits");
 
     for (auto& step : raw_steps) {
+        step.self_decompress();
         bbapi::ChonkLoad{
             .circuit = { .name = step.function_name,
                          .bytecode = std::move(step.bytecode),
-- 
