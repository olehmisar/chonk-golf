@@ -59,6 +62,71 @@ void write_chonk_vk(std::vector<uint8_t> bytecode, const std::filesystem::path&
         write_file(output_path / "vk", response.bytes);
     }
 }
+
+/**
+ * @brief Parses the bytecode of every step in order on a background thread, so that parsing the upcoming circuits
+ * overlaps accumulation (proving) of the current one.
+ */
+class BytecodeParser {
+  public:
+    explicit BytecodeParser(std::vector<PrivateExecutionStepRaw>& steps)
+        : raw_steps(steps)
+    {
+#ifndef NO_MULTITHREADING
+        promises.resize(steps.size());
+        futures.reserve(steps.size());
+        for (auto& promise : promises) {
+            futures.push_back(promise.get_future());
+        }
+        worker = std::thread([this]() {
+            for (size_t i = 0; i < raw_steps.size() && !stop.load(std::memory_order_relaxed); ++i) {
+                try {
+                    promises[i].set_value(parse(i));
+                } catch (...) {
+                    promises[i].set_exception(std::current_exception());
+                }
+            }
+        });
+#endif
+    }
+
+    BytecodeParser(const BytecodeParser&) = delete;
+    BytecodeParser& operator=(const BytecodeParser&) = delete;
+    BytecodeParser(BytecodeParser&&) = delete;
+    BytecodeParser& operator=(BytecodeParser&&) = delete;
+
+    ~BytecodeParser()
+    {
+#ifndef NO_MULTITHREADING
+        stop.store(true, std::memory_order_relaxed);
+        worker.join();
+#endif
+    }
+
+    // Blocks until step i is parsed. Each step is retrieved once, in order.
+    acir_format::AcirFormat get(size_t i)
+    {
+#ifndef NO_MULTITHREADING
+        return futures[i].get();
+#else
+        return parse(i);
+#endif
+    }
+
+  private:
+    acir_format::AcirFormat parse(size_t i)
+    {
+        return acir_format::circuit_buf_to_mega_acir_format(std::move(raw_steps[i].bytecode));
+    }
+
+    std::vector<PrivateExecutionStepRaw>& raw_steps;
+#ifndef NO_MULTITHREADING
+    std::vector<std::promise<acir_format::AcirFormat>> promises;
+    std::vector<std::future<acir_format::AcirFormat>> futures;
+    std::atomic<bool> stop = false;
+    std::thread worker;
+#endif
+};
 } // anonymous namespace
 
 void ChonkAPI::prove(const Flags& flags,
@@ -77,17 +145,21 @@ void ChonkAPI::prove(const Flags& flags,
     }
     bbapi::ChonkStart{ .kinds = std::move(kinds) }.execute(request);
     info("Chonk: starting with ", raw_steps.size(), " circuits");
+
+    // The hiding kernel bytecode is needed again to derive its VK below.
+    const std::vector<uint8_t> hiding_kernel_bytecode =
+        flags.write_vk ? raw_steps.back().bytecode : std::vector<uint8_t>{};
+
+    // Bytecode parsing draws no randomness, so parsing ahead on a background thread leaves the order of RNG draws
+    // (witness gap filling, circuit construction, proving) unchanged; the witnesses are still parsed in order, step
+    // by step, by ChonkAccumulate.
+    BytecodeParser parser(raw_steps);
     for (size_t i = 0; i < raw_steps.size(); ++i) {
-        const auto& step = raw_steps[i];
-        bbapi::ChonkLoad{
-            .circuit = { .name = step.function_name, .bytecode = step.bytecode, .verification_key = step.vk },
-            .kind = step.kind,
-        }
-            .execute(request);
+        auto& step = raw_steps[i];
+        bbapi::chonk_load_constraints(request, step.function_name, parser.get(i), std::move(step.vk), step.kind);
 
-        // NOLINTNEXTLINE(bugprone-unchecked-optional-access): we know the optional has been set here.
         info("Chonk: accumulating " + step.function_name);
-        bbapi::ChonkAccumulate{ .witness = step.witness }.execute(request);
+        bbapi::ChonkAccumulate{ .witness = std::move(step.witness) }.execute(request);
     }
 
     auto proof = bbapi::ChonkProve{}.execute(request).proof;
@@ -118,7 +190,7 @@ void ChonkAPI::prove(const Flags& flags,
         // Write CHONK vk for the hiding kernel (last step) — proven as MegaZK.
         Flags hiding_flags = flags;
         hiding_flags.circuit_kind = "hiding";
-        write_chonk_vk(raw_steps[raw_steps.size() - 1].bytecode, output_dir, hiding_flags);
+        write_chonk_vk(hiding_kernel_bytecode, output_dir, hiding_flags);
     }
 }
 
